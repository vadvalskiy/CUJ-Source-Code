    typedef const T _FARQ *const_pointer;
    typedef T _FARQ& reference;
    typedef const T _FARQ& const_reference;
    typedef T value_type;
    pointer address(reference x) const
        {return (&x); }
    const_pointer address(const_reference x) const
        {return (&x); }
